# Copy this file to backend/.env and fill in the values.

# Port for the API + Socket.IO server. The frontend proxy (frontend/package.json)
# and the socket ENDPOINT (frontend/src/components/SingleChat.js) expect 5006.
PORT=5006

# MongoDB connection string (local instance or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/chatzone

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# "development" runs the API only (use the React dev server on :3000).
# "production" also serves frontend/build from Express.
NODE_ENV=development

# Optional: extra origins allowed to open a socket, comma-separated.
# Any localhost origin is always allowed.
# CLIENT_URL=https://chat.example.com
